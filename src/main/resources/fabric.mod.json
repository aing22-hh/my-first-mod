{
	"schemaVersion": 1,
	"id": "modid",
	"version": "${version}",
	"name": "Level Up",
	"description": "Earn XP by defeating mobs, level up, and track your progress with a custom HUD card.",
	"authors": ["aing22-hh"],
	"contact": {
		"sources": "https://github.com/aing22-hh/my-first-mod"
	},
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"main": ["com.example.ExampleMod"],
		"client": ["com.example.client.ExampleModClient"]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
